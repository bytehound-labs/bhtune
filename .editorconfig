root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.rs]
indent_size = 4

[*.ps1]
indent_size = 4

[*.nsi]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_style = tab

[*.bash]
indent_style = tab

[scripts/aurpkg]
indent_style = tab
