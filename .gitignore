# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# ctags
/tags
tags.*

# Local env files (secrets restored via `ds`); keep the committed template
.env
.env.*
!.env.example

# Generated coverage reports
lcov.info
*.profraw

# Node / pnpm (frontend/, once it exists — see AGENTS.md)
node_modules/
dist/
.pnpm-store/

# Tauri build output
frontend/src-tauri/target/

# SQLite databases used by local/manual testing (never commit real data)
*.db
*.db-shm
*.db-wal
