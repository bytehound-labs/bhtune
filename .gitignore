# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# ctags (matches only a bare "tags" file, not source files that happen to be named
# "tags.<ext>" — e.g. crates/bhtune-core/src/tags.rs)
**/tags

# Local env files (secrets restored via `ds`); keep the committed template
.env
.env.*
!.env.example

# Generated coverage reports
lcov.info
*.profraw

# Node / pnpm (frontend/)
node_modules/
dist/
.pnpm-store/

# Playwright (frontend/e2e/) test artifacts
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/

# SQLite databases used by local/manual testing (never commit real data)
*.db
*.db-shm
*.db-wal

# Python (scripts/convert_golden_trace.py)
__pycache__/
*.pyc

# cargo-fuzz output
fuzz/artifacts/
fuzz/corpus/

# Personal Copilot instructions (symlinked from ~/git/Work)
copilot-instructions.md
