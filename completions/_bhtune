#compdef bhtune

autoload -U is-at-least

_bhtune() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--config=[Path to a TOML config file (default\: platform-specific, see \`crate\:\:config\`)]:PATH:_files' \
'--db=[Path to the SQLite database file (default\: a platform-standard data directory, see \`crate\:\:config\:\:default_db_path_from\`). CLI > \`BHTUNE_DB\` env var > \`db\` in the config file > platform default -- see \`crate\:\:config\:\:resolve_db_path\`]:PATH:_files' \
'--templates=[Path to a user-supplied DCS/PLC template catalog, auto-loaded on every startup in addition to the built-in templates (default\: platform-specific, next to the config file -- see \`crate\:\:config\:\:templates_path_from\`). A missing file at the default location is fine; a file that fails to parse or validate is a hard error. CLI > \`BHTUNE_TEMPLATES\` env var > \`templates\` in the config file > platform default -- see \`crate\:\:config\:\:load_user_templates\`]:PATH:_files' \
'--retention-days=[Delete tune runs (and their samples/results/write-back audit rows) older than this many days, automatically, on every startup (default\: unset -- retain forever). CLI > \`BHTUNE_RETENTION_DAYS\` env var > \`retention_days\` in the config file > (no default) -- see \`crate\:\:config\:\:resolve_retention_days\`. \`bhtune history prune\` applies the same policy on demand, with a \`--dry-run\` preview, instead of waiting for the next startup]:RETENTION_DAYS:_default' \
'--log-level=[Log level / directive spec, e.g. "info" or "bhtune_cli=debug,sqlx=warn" (default\: info). Diagnostic detail only -- never printed to stdout, so it can never interleave with \`--output json\`'\''s single-object contract; see \`crate\:\:logging\`]:LOG_LEVEL:_default' \
'--log-dir=[Directory to write log files to (default\: a platform-standard data directory, see \`crate\:\:config\:\:default_log_dir_from\`)]:PATH:_files' \
'--log-format=[Log file format\: "pretty" or "json" (default\: pretty)]:LOG_FORMAT:_default' \
'--log-rotation=[Log file rotation\: "hourly", "daily", or "never" (default\: daily)]:LOG_ROTATION:_default' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_bhtune_commands" \
"*::: :->bhtune" \
&& ret=0
    case $state in
    (bhtune)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:bhtune-command-$line[1]:"
        case $line[1] in
            (tune)
_arguments "${_arguments_options[@]}" : \
'-t+[PV tag prefix; the rest of the tag set is derived from it using \`--template\`'\''s suffix convention. Ignored for \`--driver simulator\`, which uses two fixed internal tag names instead]:TAGNAME:_default' \
'--tagname=[PV tag prefix; the rest of the tag set is derived from it using \`--template\`'\''s suffix convention. Ignored for \`--driver simulator\`, which uses two fixed internal tag names instead]:TAGNAME:_default' \
'--template=[DCS/PLC template name (see \`bhtune template list\`)]:TEMPLATE:_default' \
'--process-type=[]:PROCESS_TYPE:(flow pressure-line pressure-vessel level temperature-mixing temperature-heat-exchange)' \
'--controller-type=[]:CONTROLLER_TYPE:(p pi pid)' \
'--relay-amp=[Relay amplitude, as a percentage of the MV range]:RELAY_AMP:_default' \
'--cycles-skip=[Relay cycles to skip before counting begins (default\: looked up per \`--process-type\`)]:CYCLES_SKIP:_default' \
'--cycles-count=[Relay cycles to count once the skip period ends (default\: looked up per \`--process-type\`)]:CYCLES_COUNT:_default' \
'--noise-protection-secs=[Seconds a switch must persist before it'\''s accepted (default\: looked up per \`--process-type\`)]:NOISE_PROTECTION_SECS:_default' \
'--mrft-delay=[Pre/post-test recording padding, in seconds (legacy\: \`--mrftDelayTime\`)]:MRFT_DELAY:_default' \
'--driver=[Which driver drives this tune]:DRIVER:((opcda\:"A real OPC DA server, reached through an opcda-bridge gateway"
simulator\:"The in-process FOPDT simulator — no external dependency at all"))' \
'--bridge-host=[opcda-bridge gateway address. bhtune connects to the bridge gateway rather than a DCOM host directly — see AGENTS.md'\''s OPC DA integration notes. Only meaningful with \`--driver opcda\` (default\: \`crate\:\:config\:\:DEFAULT_BRIDGE_HOST\`, overridable via the \`BHTUNE_BRIDGE_HOST\` env var or the config file'\''s \`bridge_host\` key)]:BRIDGE_HOST:_default' \
'--server=[OPC DA server ProgID (legacy\: \`-s\`/\`--opcServerID\`). Required with \`--driver opcda\`]:SERVER:_default' \
'--sim-gain=[Simulator process gain (\`--driver simulator\` only)]:SIM_GAIN:_default' \
'--sim-tau=[Simulator process time constant, in seconds (\`--driver simulator\` only)]:SIM_TAU:_default' \
'--sim-dead-time=[Simulator dead time, in seconds (\`--driver simulator\` only)]:SIM_DEAD_TIME:_default' \
'--sim-noise=[Simulator measurement noise amplitude (\`--driver simulator\` only)]:SIM_NOISE:_default' \
'--sim-seed=[Simulator RNG seed, for reproducible noise (\`--driver simulator\` only)]:SIM_SEED:_default' \
'--sim-initial-pv=[Simulator initial PV (\`--driver simulator\` only)]:SIM_INITIAL_PV:_default' \
'--sim-initial-mv=[Simulator initial MV (\`--driver simulator\` only)]:SIM_INITIAL_MV:_default' \
'--pv-range-high=[Fixed PV range high, overriding a live tag read (legacy\: the PV range "toggle tag/value" button). Required (defaults to 100.0) for \`--driver simulator\`, which has no range tags at all]:PV_RANGE_HIGH:_default' \
'--pv-range-low=[Fixed PV range low, overriding a live tag read]:PV_RANGE_LOW:_default' \
'--mv-range-high=[Fixed MV range high, overriding a live tag read]:MV_RANGE_HIGH:_default' \
'--mv-range-low=[Fixed MV range low, overriding a live tag read]:MV_RANGE_LOW:_default' \
'--direction=[Fixed controller direction, overriding a live tag read]:DIRECTION:(direct reverse)' \
'--poll-interval-ms=[How often to poll the driver, in milliseconds (legacy\: the 800 ms WinForms timer)]:POLL_INTERVAL_MS:_default' \
'--timeout-secs=[Hard wall-clock cap on this run'\''s total duration (including any \`--mrft-delay\` padding), in seconds. If the engine hasn'\''t reported completion by the deadline, the run is aborted and the loop is automatically restored, exactly like Ctrl+C -- but with no one present to press it. Always enforced; there is no way to disable it, since an unattended run must never be able to perturb a live process indefinitely. Size this to comfortably exceed your slowest loop'\''s expected test duration -- temperature loops in particular can need much longer than the default]:TIMEOUT_SECS:_default' \
'--notes=[Operator notes to attach to this run. Notes can be edited or cleared from the web GUI while the run is active or after it finishes]:NOTES:_default' \
'--write-pid=[Non-interactively write this response level'\''s calculated PID parameters back to the DCS instead of prompting on stdin -- the flag that makes a scheduled/scripted tune able to actually update a loop with no one watching. Requires \`--yes\`]:WRITE_PID:(aggressive moderate sluggish)' \
'--op-timeout-secs=[Cap on any single driver read/write during the run, in seconds. A stalled call (gateway down, DCOM wedged, network black-holed) is abandoned rather than awaited forever once this elapses, so Ctrl+C and \`--timeout-secs\` both stay effective even mid-hung-read/write -- see AGENTS.md'\''s \`safety-cancellation\` section. Distinct from \`--timeout-secs\`, which bounds the whole run rather than one operation; size this well above a healthy round trip to your OPC DA gateway, not to the expected test duration]:OP_TIMEOUT_SECS:_default' \
'--restore-timeout-secs=[Cap on restoring the loop to its pre-test mode/MV/setpoint after the run ends (by completion, Ctrl+C, or a timeout), in seconds. Bounded independently of \`--timeout-secs\`, since a restore triggered *by* a timeout would otherwise inherit an already-expired budget. If this elapses (or a second Ctrl+C arrives first), the run exits \`EXIT_RESTORE_INCOMPLETE\` with a warning naming the loop and its last-written value, instead of hanging indefinitely]:RESTORE_TIMEOUT_SECS:_default' \
'--output=[How to print this run'\''s final outcome line]:OUTPUT:((table\:"Human-readable text (default)"
json\:"Pretty-printed JSON. This is the external contract for scripted/scheduled consumers, so its shape must not change silently once shipped"))' \
'--config=[Path to a TOML config file (default\: platform-specific, see \`crate\:\:config\`)]:PATH:_files' \
'--db=[Path to the SQLite database file (default\: a platform-standard data directory, see \`crate\:\:config\:\:default_db_path_from\`). CLI > \`BHTUNE_DB\` env var > \`db\` in the config file > platform default -- see \`crate\:\:config\:\:resolve_db_path\`]:PATH:_files' \
