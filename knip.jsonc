{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": ["prettier"],
    },
    "frontend": {
      "entry": [
        "e2e/start-server.mjs",
        "e2e/start-demo-server.mjs",
        "e2e/demo-proxy.mjs",
      ],
      "ignoreBinaries": ["openssl"],
      "ignoreIssues": {
        "src/api/schema.d.ts": ["types"],
      },
    },
    "website": {
      "ignoreDependencies": ["@easyops-cn/docusaurus-search-local"],
      "ignoreIssues": {
        "docusaurus.config.ts": ["unlisted"],
      },
    },
  },
}
