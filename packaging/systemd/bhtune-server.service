# bhtune-server systemd unit for package-managed installs (Linux)
#
# This is the canonical unit shared by the .deb, .rpm, and AUR packages. Those packages
# install the binary at `/usr/bin/bhtune-server` and this unit at
# `/usr/lib/systemd/system/bhtune-server.service`. Package installation never enables or
# starts the service; an operator explicitly runs:
#
#   sudo systemctl enable --now bhtune-server
#
# The manual archive-install unit remains at `packaging/systemd/manual/bhtune-server.service`
# and uses `/usr/local/bin/bhtune-server`.

[Unit]
Description=BHTune Server -- MRFT PID auto-tuning HTTP API and web GUI
Documentation=https://github.com/bytehound-labs/bhtune
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/bhtune-server
Restart=on-failure
RestartSec=5

DynamicUser=true
StateDirectory=bhtune
ConfigurationDirectory=bhtune
Environment=XDG_CONFIG_HOME=/etc
Environment=XDG_DATA_HOME=/var/lib

# Hardening. bhtune-server needs no elevated privileges: it binds a single unprivileged TCP
# port (127.0.0.1:8787 by default), reads its config/template files, and reads/writes its
# own SQLite database -- nothing here needs a capability, device access, or write access to
# the rest of the filesystem.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
